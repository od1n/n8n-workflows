  {
   "parameters": {
    "jsCode": "const item = $input.first().json;\n\nlet raw = '';\nif (typeof item === 'string') raw = item;\nelse if (item.content && Array.isArray(item.content) && item.content[0] && item.content[0].text) raw = item.content[0].text;\nelse if (item.text) raw = item.text;\nelse if (item.message && item.message.content && item.message.content[0] && item.message.content[0].text) raw = item.message.content[0].text;\nelse raw = JSON.stringify(item);\n\nraw = raw.trim().replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/i, '');\n\nlet parsed;\ntry {\n    parsed = JSON.parse(raw);\n} catch (e) {\n    parsed = {\n          veredicto: 'error_parseo',\n          confianza: 0,\n          razones: 'No se pudo interpretar la respuesta de Claude: ' + raw.slice(0, 300),\n          recomendacion: 'Revisar el mensaje manualmente.'\n    };\n}\n\nconst original = $('Filtrar remitente Fiverr').first().json;\n\nreturn [{\n    json: {\n          veredicto: parsed.veredicto,\n          confianza: parsed.confianza,\n          razones: parsed.razones,\n          recomendacion: parsed.recomendacion,\n          asuntoOriginal: original.subject || '',\n          remitente: original.from || '',\n          textoOriginal: original.text || original.textPlain || '',\n          fecha: original.date || ''\n    }\n}];"
   },
